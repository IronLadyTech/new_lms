# Staging Firebase web app — copy to .env.staging (gitignored).
# Project id MUST NOT be lmsironlady (production).
# Create the project first; see docs/SCALE_TESTING.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=lmsironlady-staging
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Throwaway staff for load / a11y (never a real learner).
# STAFF_EMAIL=load-admin@example.com
# STAFF_PASSWORD=

# Admin SDK path for seed + write load (optional; prefer GOOGLE_APPLICATION_CREDENTIALS).
# LOADTEST_SERVICE_ACCOUNT=.secrets/staging-sa.json
LOADTEST_PROJECT_ID=lmsironlady-staging
