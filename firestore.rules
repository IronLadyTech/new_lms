rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Bootstrap owner — auth token email works even without a Firestore profile.
    function isBootstrapSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'ironladytech@gmail.com';
    }

    function userRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isGuest() {
      return userRole() == 'guest';
    }

    function isBlockedUser() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == true;
    }

    function isSuperAdmin() {
      return isBootstrapSuperAdmin() || userRole() == 'superadmin';
    }

    function isAdmin() {
      return isBootstrapSuperAdmin() || userRole() in ['admin', 'superadmin'];
    }

    function isModerator() {
      return isBootstrapSuperAdmin() || userRole() in ['moderator', 'admin', 'superadmin'];
    }

    function hasStaffAccess() {
      return isModerator();
    }

    function hasAdminAccess() {
      return isAdmin();
    }

    function canUseApp() {
      return isSignedIn()
        && !isGuest()
        && (!isBlockedUser() || hasStaffAccess() || isBootstrapSuperAdmin());
    }

    function groupMemberIds(groupData) {
      return groupData.keys().hasAny(['memberIds']) ? groupData.memberIds : [];
    }

    function isGroupMember(groupData) {
      return request.auth.uid in groupMemberIds(groupData);
    }

    function moderatorLearnerBatchFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['batchId', 'batchName', 'program', 'updatedAt']);
    }

    function learnerMbwStatusOk() {
      return !request.resource.data.keys().hasAny(['status'])
        || request.resource.data.status in [
          'unlocked', 'submitted', 'under_review',
          'needs_improvement', 'rejected', 'completed'
        ];
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || hasStaffAccess());
      allow create: if isSignedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny([
          'lmsCredentialPassword', 'accessTier', 'paymentStatus', 'provisionedFromZoho'
        ]);
      allow update: if isSignedIn() && (
          request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'role', 'blocked', 'lmsCredentialPassword', 'accessTier', 'paymentStatus', 'provisionedFromZoho'
            ])
          || isSuperAdmin()
          || (isAdmin() && request.resource.data.role in ['student', 'moderator', 'admin']
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'lmsCredentialPassword', 'accessTier', 'paymentStatus', 'provisionedFromZoho'
            ]))
          || (hasAdminAccess() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked', 'updatedAt']))
          || (hasStaffAccess() && moderatorLearnerBatchFieldsOnly())
          || (request.auth.uid == userId && isBootstrapSuperAdmin())
        );
      allow delete: if isSuperAdmin();
    }

    match /courses/{courseId} {
      allow read: if canUseApp();
      allow write: if hasAdminAccess();
    }

    match /resources/{resourceId} {
      allow read: if canUseApp()
        && (hasStaffAccess() || resource.data.locked != true);
      allow write: if hasAdminAccess();
    }

    match /assignments/{assignmentId} {
      allow read: if canUseApp();
      allow write: if hasAdminAccess();
    }

    match /activities/{activityId} {
      allow read: if canUseApp() && (
        resource.data.userId == request.auth.uid || hasStaffAccess()
      );
      allow create: if canUseApp() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    match /groups/{groupId} {
      allow read: if canUseApp() && (hasStaffAccess() || isGroupMember(resource.data));
      // CX moderators create/update batches; only admins delete cohorts.
      allow create, update: if hasStaffAccess();
      allow delete: if hasAdminAccess();

      /*
       * Session recordings — the video links themselves.
       *
       * These used to live in a `recordings` array on the batch document, and
       * batch members can read that document, so a learner who had paid only
       * the registration fee could read the links to every paid session in
       * their cohort. Firestore cannot withhold a single field, so the links
       * had to move somewhere learners cannot read at all.
       *
       * getLessonAsset reads this with admin privileges after checking that the
       * learner has paid for the programme, and is the only route to a URL.
       */
      match /recordings/{recordingId} {
        allow read, write: if hasStaffAccess();
      }
    }

    match /events/{eventId} {
      allow read: if canUseApp();
      allow write: if hasAdminAccess();
    }

    match /announcements/{announcementId} {
      allow read: if canUseApp();
      allow write: if hasAdminAccess();
    }

    // Public guest enquiry form (no account required). Write-only for the public:
    // create is allowed unauthenticated but strictly shape- and length-validated,
    // and nobody without staff access can read anything back.
    match /access_requests/{requestId} {
      allow read, update, delete: if hasStaffAccess();
      allow create: if request.resource.data.keys().hasOnly(
            ['name', 'email', 'program', 'message', 'status', 'source', 'createdAt']
          )
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 200
        && request.resource.data.program is string
        && request.resource.data.program.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'lms_guest';
    }

    match /tickets/{ticketId} {
      allow read: if canUseApp() && (
        resource.data.userId == request.auth.uid || hasStaffAccess()
      );
      allow create: if canUseApp()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open';
      allow update: if hasStaffAccess()
        || (request.auth.uid == resource.data.userId
          && resource.data.status != 'resolved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['subject', 'category', 'updatedAt']));
      allow delete: if hasStaffAccess()
        || (request.auth.uid == resource.data.userId && resource.data.status == 'open');

      match /messages/{messageId} {
        allow read: if canUseApp() && (
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid
          || hasStaffAccess()
        );
        allow create: if canUseApp() && (
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid
          || hasStaffAccess()
        );
        allow delete: if hasStaffAccess()
          || get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid;
      }
    }

    match /learner_submissions/{submissionId} {
      allow read: if canUseApp() && (
        resource.data.learnerId == request.auth.uid || hasStaffAccess()
      );
      allow create: if canUseApp()
        && request.resource.data.learnerId == request.auth.uid
        && request.resource.data.isCorrect is bool
        && request.resource.data.courseId is string;
      // setDoc(merge:true) on an existing doc is evaluated as update.
      allow update: if hasStaffAccess()
        || (canUseApp()
          && resource.data.learnerId == request.auth.uid
          && request.resource.data.learnerId == request.auth.uid
          && request.resource.data.isCorrect == resource.data.isCorrect
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['learnerId', 'courseId', 'problemId', 'isCorrect', 'timestamp', 'dateKey']));
      allow delete: if hasStaffAccess();
    }

    match /attendance/{recordId} {
      allow read: if canUseApp() && (
        resource.data.learnerId == request.auth.uid || hasStaffAccess()
      );
      allow create: if hasStaffAccess()
        || (canUseApp()
          && request.resource.data.learnerId == request.auth.uid
          && request.resource.data.status == 'present');
      // setDoc(merge:true) re-sends identity fields — allow idempotent learner upserts.
      allow update: if hasStaffAccess()
        || (canUseApp()
          && resource.data.learnerId == request.auth.uid
          && request.resource.data.learnerId == request.auth.uid
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.date == resource.data.date
          && request.resource.data.status == 'present');
      allow delete: if hasStaffAccess();
    }

    match /mbw_submissions/{submissionId} {
      function isOwnMbwSubmissionId() {
        return submissionId.size() > request.auth.uid.size() + 1
          && submissionId[0:request.auth.uid.size()] == request.auth.uid
          && submissionId[request.auth.uid.size():request.auth.uid.size() + 1] == '_';
      }

      function learnerClearingMbwReviewFields() {
        return !request.resource.data.keys()
          .hasAny(['reviewedBy', 'reviewedAt', 'feedback', 'reviewOutcome']);
      }

      function learnerMbwReviewHistoryOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewHistory'])
          || (learnerClearingMbwReviewFields()
              && request.resource.data.reviewHistory.size()
                 >= resource.data.get('reviewHistory', []).size());
      }

      allow read: if canUseApp() && (
        hasStaffAccess()
        || (resource == null && isOwnMbwSubmissionId())
        || resource.data.userId == request.auth.uid
      );
      allow create: if hasStaffAccess()
        || (canUseApp()
          && isOwnMbwSubmissionId()
          && request.resource.data.userId == request.auth.uid
          && learnerMbwStatusOk());
      allow update: if hasStaffAccess()
        || (canUseApp()
          && isOwnMbwSubmissionId()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          // A learner may never SET review fields, but must be able to CLEAR them
          // on resubmit. So either the update leaves all review keys untouched, or
          // it removes every one of them (none remain in the resulting doc).
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['reviewedBy', 'reviewedAt', 'feedback', 'reviewOutcome'])
              || !request.resource.data.keys()
                   .hasAny(['reviewedBy', 'reviewedAt', 'feedback', 'reviewOutcome']))
          && learnerMbwReviewHistoryOk()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || learnerMbwStatusOk()));
      allow delete: if hasStaffAccess();
    }

    /*
     * Lesson media — the video links themselves.
     *
     * Learners must never read this collection. The links used to ship inside
     * the client bundle, so anyone who signed up could read them out of the
     * page and watch paid content; putting them in a learner-readable
     * collection would recreate exactly that. getLessonAsset reads them with
     * admin privileges after checking entitlement, and is the only route out.
     *
     * Staff read so the team can manage links for their batches.
     */
    match /lesson_media/{lessonId} {
      allow read: if hasStaffAccess();
      allow write: if hasStaffAccess();
    }

    match /mbw_tasks/{taskId} {
      allow read: if canUseApp();
      allow write: if hasAdminAccess();
    }

    match /bm100_submissions/{submissionId} {
      function isOwnBm100SubmissionId() {
        return submissionId.size() > request.auth.uid.size() + 1
          && submissionId[0:request.auth.uid.size()] == request.auth.uid
          && submissionId[request.auth.uid.size():request.auth.uid.size() + 1] == '_';
      }

      function learnerClearingBm100ReviewFields() {
        return !request.resource.data.keys()
          .hasAny(['reviewedBy', 'reviewedAt', 'feedback', 'reviewOutcome']);
      }

      function learnerBm100ReviewHistoryOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewHistory'])
          || (learnerClearingBm100ReviewFields()
              && request.resource.data.reviewHistory.size()
                 >= resource.data.get('reviewHistory', []).size());
      }

      allow read: if canUseApp() && (
        hasStaffAccess()
        || (resource == null && isOwnBm100SubmissionId())
        || resource.data.userId == request.auth.uid
      );
      allow create: if hasStaffAccess()
        || (canUseApp()
          && isOwnBm100SubmissionId()
          && request.resource.data.userId == request.auth.uid
          && learnerMbwStatusOk());
      allow update: if hasStaffAccess()
        || (canUseApp()
          && isOwnBm100SubmissionId()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid
          // A learner may never SET review fields, but must be able to CLEAR them
          // on resubmit. So either the update leaves all review keys untouched, or
          // it removes every one of them (none remain in the resulting doc).
          && (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['reviewedBy', 'reviewedAt', 'feedback', 'reviewOutcome'])
              || !request.resource.data.keys()
                   .hasAny(['reviewedBy', 'reviewedAt', 'feedback', 'reviewOutcome']))
          && learnerBm100ReviewHistoryOk()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || learnerMbwStatusOk()));
      allow delete: if hasStaffAccess();
    }

    match /bm100_tasks/{taskId} {
      allow read: if canUseApp();
      allow write: if hasAdminAccess();
    }

    match /storage_objects/{objectId} {
      allow read: if isSuperAdmin()
        || hasStaffAccess()
        || (canUseApp() && resource.data.uploadedBy == request.auth.uid);
      allow create, update: if hasAdminAccess()
        || (canUseApp() && request.resource.data.uploadedBy == request.auth.uid);
      allow delete: if isSuperAdmin();
    }
  }
}

