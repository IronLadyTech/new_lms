rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function userRole() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : '';
    }

    function isBootstrapOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'ironladytech@gmail.com';
    }

    function isStaffUser() {
      return request.auth != null
        && (
          isBootstrapOwner()
          || userRole() in ['moderator', 'admin', 'superadmin']
        );
    }

    function isAdminUser() {
      return request.auth != null
        && (
          isBootstrapOwner()
          || userRole() in ['admin', 'superadmin']
        );
    }

    match /resources/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdminUser();
    }

    match /courses/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdminUser();
    }

    // MBW resume / mirror-practice uploads — owner writes; staff can read for review
    match /mbw/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaffUser());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 100BM task uploads — owner writes; CX/admin staff can read for review.
    match /bm100/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaffUser());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    /*
     * LEP task uploads — owner writes; CX/admin staff read for review.
     *
     * This path was missing while lep_submissions already existed, so a learner
     * could save the record of an upload and never the file: Storage refused
     * every write. Same omission as the Firestore rules, found the same way.
     *
     * The size ceiling is enforced here as well as in the client, because a
     * client-side check only stops the honest mistake. 200MB matches the video
     * cap the recorder applies; documents are held to 15MB below.
     */
    match /lep/{userId}/{taskId}/video/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaffUser());
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 200 * 1024 * 1024;
    }

    match /lep/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isStaffUser());
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 15 * 1024 * 1024;
    }

    match /events/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdminUser();
    }
  }
}
