# Firebase — https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Task video/file uploads are enabled by default. Set either to false only for
# an intentional offline/local deployment.
VITE_MBW_STORAGE_ENABLED=true
VITE_BM100_STORAGE_ENABLED=true

# Dev only: set to true to show "Continue with Google" on signup (not login).
# Paid learners must use welcome-email + password — Google does not provision from Zoho.
# VITE_ENABLE_GOOGLE_AUTH=false

# Web Push (FCM) — Firebase Console → Project settings → Cloud Messaging →
# Web Push certificates → "Key pair". Required for push notifications; if unset,
# push is silently disabled. Set this on every deploy target (e.g. Vercel) too.
VITE_FIREBASE_VAPID_KEY=

# App Check (optional — enable in Firebase Console → App Check first)
# reCAPTCHA v3 site key for the web app; enforces abuse protection on Auth/Functions.
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Dev only: register debug token in Firebase Console → App Check → Manage debug tokens
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Zoho CRM — put credentials in functions/.env (copy from functions/.env.example)
# NOT in this root .env file
